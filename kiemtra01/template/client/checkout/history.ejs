<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Lịch sử đơn hàng - LaptopShop</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/client/css/bootstrap.min.css" rel="stylesheet">
    <link href="/client/css/style.css" rel="stylesheet">
    <style>
        body { background: #f4f7fe; font-family: 'Outfit', sans-serif; }
        .page-header-hist { background: linear-gradient(135deg,#6366f1,#a855f7); padding: 60px 0 40px; margin-top: 120px; }
        .order-card {
            background: white; border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            margin-bottom: 20px; overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .order-card:hover { transform: translateY(-3px); box-shadow: 0 8px 32px rgba(99,102,241,0.1); }
        .order-card-header {
            background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(168,85,247,0.06));
            padding: 16px 24px; display: flex; justify-content: space-between;
            align-items: center; border-bottom: 1px solid rgba(0,0,0,0.05);
            flex-wrap: wrap; gap: 8px;
        }
        .order-id { font-weight: 700; color: #6366f1; font-size: 1rem; }
        .order-date { color: #94a3b8; font-size: 0.85rem; }
        .status-badge {
            border-radius: 20px; padding: 4px 14px; font-size: 0.8rem; font-weight: 700;
        }
        .status-pending { background: rgba(251,191,36,0.15); color: #d97706; }
        .status-completed { background: rgba(16,185,129,0.12); color: #059669; }
        .status-cancelled { background: rgba(239,68,68,0.12); color: #dc2626; }
        .order-item-mini { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #f8fafc; }
        .order-item-mini:last-child { border-bottom: none; }
        .order-item-mini .item-name { font-weight: 600; font-size: 0.9rem; color: #1e293b; }
        .order-item-mini .item-price { font-size: 0.85rem; color: #6366f1; font-weight: 600; }
        .empty-state { text-align: center; padding: 80px 20px; }
        .empty-icon { font-size: 72px; margin-bottom: 20px; opacity: 0.4; }
        .payment-chip {
            display: inline-flex; align-items: center; gap: 6px;
            background: #f1f5f9; border-radius: 8px; padding: 4px 10px; font-size: 0.8rem; color: #475569;
        }
    </style>
</head>
<body>
    <%- include('../layout/header'); -%>

    <div class="page-header-hist">
        <div class="container">
            <h1 class="text-white fw-bold mb-1">Lịch sử đơn hàng</h1>
            <div style="color:rgba(255,255,255,0.75); font-size:0.9rem;">
                <a href="/" style="color:rgba(255,255,255,0.75); text-decoration:none;">Trang chủ</a>
                <span class="mx-2">/</span>
                <span class="text-white">Lịch sử đơn hàng</span>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <% if (orders && orders.length > 0) { %>
            <div class="mb-3 text-muted"><%= orders.length %> đơn hàng</div>
            <% orders.forEach(order => { %>
            <div class="order-card">
                <div class="order-card-header">
                    <div>
                        <div class="order-id">#<%= order.id %></div>
                        <div class="order-date"><i class="far fa-clock me-1"></i><%= new Date(order.created_at).toLocaleString('vi-VN') %></div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="payment-chip">
                            <% if(order.payment_method === 'cod') { %>💵 COD
                            <% } else if(order.payment_method === 'bank_transfer') { %>🏦 Chuyển khoản
                            <% } else { %>💳 MoMo<% } %>
                        </div>
                        <span class="status-badge status-<%= order.status %>">
                            <% if(order.status === 'pending') { %>⏳ Đang xử lý
                            <% } else if(order.status === 'completed') { %>✅ Hoàn thành
                            <% } else { %>❌ Đã huỷ<% } %>
                        </span>
                    </div>
                </div>

                <div class="px-4 py-3">
                    <!-- Receiver info -->
                    <div class="mb-3 text-muted small">
                        <i class="fas fa-map-marker-alt me-1 text-primary"></i>
                        <strong><%= order.receiver_name %></strong> — <%= order.receiver_phone %>
                        <br><span class="ms-3"><%= order.receiver_address %></span>
                        <% if(order.note) { %><br><span class="ms-3 fst-italic">Ghi chú: <%= order.note %></span><% } %>
                    </div>

                    <!-- Items -->
                    <% if(order.items && order.items.length > 0) { %>
                        <% order.items.forEach(item => { %>
                        <div class="order-item-mini">
                            <div class="flex-grow-1">
                                <div class="item-name"><%= item.item_name %></div>
                                <div class="text-muted" style="font-size:0.8rem;">Số lượng: x<%= item.quantity %></div>
                            </div>
                            <div class="item-price"><%= new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND'}).format(item.item_price * item.quantity) %></div>
                        </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="px-4 py-3 bg-light d-flex justify-content-between align-items-center rounded-bottom">
                    <span class="text-muted small"><%= order.items ? order.items.length : 0 %> sản phẩm</span>
                    <div>
                        <span class="text-muted me-2">Tổng cộng:</span>
                        <span class="fs-5 fw-bold text-primary"><%= new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND'}).format(order.total_amount) %></span>
                    </div>
                </div>
            </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h4 class="text-muted fw-bold mb-2">Chưa có đơn hàng nào</h4>
                <p class="text-muted mb-4">Hãy khám phá và mua sắm ngay!</p>
                <a href="/" class="btn btn-primary rounded-3 px-5 py-3 fw-bold">Mua sắm ngay</a>
            </div>
        <% } %>
    </div>

    <%- include('../layout/footer'); -%>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/js/main.js"></script>
</body>
</html>
