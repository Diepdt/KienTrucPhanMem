<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Đặt hàng thành công - LaptopShop</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="/client/css/bootstrap.min.css" rel="stylesheet">
    <link href="/client/css/style.css" rel="stylesheet">
    <style>
        .success-container {
            min-height: 80vh; display: flex; align-items: center; justify-content: center;
            font-family: 'Outfit', sans-serif;
        }
        .success-card {
            background: white; border-radius: 28px; padding: 52px 44px;
            text-align: center; max-width: 520px; width: 100%;
            box-shadow: 0 20px 60px rgba(99,102,241,0.12);
        }
        .success-icon-ring {
            width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 28px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            display: flex; align-items: center; justify-content: center;
            animation: scaleIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 30px rgba(99,102,241,0.4);
        }
        @keyframes scaleIn {
            0% { transform: scale(0); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .success-icon-ring i { font-size: 46px; color: white; }
        .order-id-badge {
            background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(168,85,247,0.1));
            border: 1px solid rgba(99,102,241,0.2);
            border-radius: 12px; padding: 14px 24px; display: inline-block;
            margin: 16px 0;
        }
        .confetti-row { font-size: 28px; line-height: 1; margin-bottom: 8px; }
        .btn-go-home {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: white; border: none; border-radius: 14px;
            padding: 14px 32px; font-size: 16px; font-weight: 700;
            transition: all 0.3s; box-shadow: 0 4px 20px rgba(99,102,241,0.35);
            text-decoration: none; display: inline-block;
        }
        .btn-go-home:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(99,102,241,0.5); color: white; }
        .btn-history { border-radius: 14px; padding: 14px 24px; font-weight: 600; }
    </style>
</head>
<body style="background: #f4f7fe;">
    <%- include('../layout/header'); -%>

    <div class="success-container mt-5 pt-4">
        <div class="container">
            <div class="success-card mx-auto">
                <div class="confetti-row">🎉 🎊 🥳</div>
                <div class="success-icon-ring">
                    <i class="fas fa-check"></i>
                </div>
                <h2 class="fw-bold text-dark mb-1" style="font-family:'Outfit',sans-serif;">Đặt hàng thành công!</h2>
                <p class="text-muted mb-3">Cảm ơn bạn đã mua sắm tại LaptopShop. Đơn hàng của bạn đang được xử lý.</p>

                <div class="order-id-badge">
                    <div class="text-muted small mb-1">Mã đơn hàng</div>
                    <div class="fw-bold fs-5 text-primary">#<%= orderId %></div>
                </div>

                <div class="my-3 py-3 border-top border-bottom">
                    <div class="text-muted small mb-1">Tổng thanh toán</div>
                    <div class="fw-bold fs-3" style="background: linear-gradient(135deg, #6366f1, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        <%= new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND'}).format(total) %>
                    </div>
                </div>

                <div class="row text-center mb-4">
                    <div class="col-4">
                        <div class="text-success fw-bold mb-1"><i class="fas fa-truck"></i></div>
                        <div class="text-muted" style="font-size:0.8rem;">Giao hàng tận nơi</div>
                    </div>
                    <div class="col-4">
                        <div class="text-info fw-bold mb-1"><i class="fas fa-headset"></i></div>
                        <div class="text-muted" style="font-size:0.8rem;">Hỗ trợ 24/7</div>
                    </div>
                    <div class="col-4">
                        <div class="text-warning fw-bold mb-1"><i class="fas fa-shield-alt"></i></div>
                        <div class="text-muted" style="font-size:0.8rem;">Bảo hành chính hãng</div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a href="/" class="btn-go-home"><i class="fas fa-home me-2"></i>Tiếp tục mua sắm</a>
                    <a href="/order-history" class="btn btn-outline-secondary btn-history">Xem lịch sử đơn hàng</a>
                </div>
            </div>
        </div>
    </div>

    <%- include('../layout/footer'); -%>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/js/main.js"></script>
</body>
</html>
