<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Dương Tuấn Điệp - B22DCCN212 - Dự án laptopshop" />
    <meta name="author" content="Dương Tuấn Điệp - B22DCCN212" />
    <title>Create Product - Dương Tuấn Điệp - B22DCCN212</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
        $(document).ready(() => {
            const productImageFile = $("#productImageFile");
            productImageFile.change(function (e) {
                const imgURL = URL.createObjectURL(e.target.files[0]);
                $("#productImagePreview").attr("src", imgURL);
                $("#productImagePreview").css({ "display": "block" });
            });
        }); 
    </script>
</head>

<body class="sb-nav-fixed">
    <%- include('../layout/header'); -%>
        <div id="layoutSidenav">
            <%- include('../layout/sidenav'); -%>
                <div id="layoutSidenav_content">
                    <main>
                        <div class="container-fluid px-4">
                            <h1 class="mt-4">Manage Products</h1>
                            <ol class="breadcrumb mb-4">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item active"><a href="/admin/product">Products</a></li>
                                <li class="breadcrumb-item active">Create product</li>
                            </ol>

                            <% errors.forEach(error=> { %>
                                <div class="alert alert-danger mb-3">
                                    <%= error.message %> - <%= error.path %>
                                </div>
                                <% }) %>
                                    <div class="row col-6 mx-auto">
                                        <form action="/admin/create-product" method="post" novalidate>
                                            <div class="mb-3">
                                                <label class="form-label">Type:</label>
                                                <select name="type" class="form-select">
                                                    <option value="laptop" <%=oldData.type==='laptop' ? 'selected' : ''
                                                        %>>Laptop</option>
                                                    <option value="mobile" <%=oldData.type==='mobile' ? 'selected' : ''
                                                        %>>Mobile</option>
                                                </select>
                                            </div>
                                            <div class="row">
                                                <div class="mb-3 col-6">
                                                    <label class="form-label">Name:</label>
                                                    <input required name="name" value="<%= oldData.name%>" type="text"
                                                        class="form-control" placeholder="Enter product name...">
                                                </div>
                                                <div class="mb-3  col-6">
                                                    <label class="form-label">Price:</label>
                                                    <input required name="price" value="<%= oldData.price%>" type="text"
                                                        class="form-control" placeholder="(đơn vị: VNĐ)">
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label required class="form-label">Detail description:</label>
                                                <textarea name="detailDesc" class="form-control"
                                                    rows="2"><%= oldData.detailDesc%></textarea>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Short description:</label>
                                                <input name="shortDesc" value="<%= oldData.shortDesc%>" type="text"
                                                    class="form-control"
                                                    placeholder="Enter the short product description ...">
                                            </div>
                                            <div class="row">
                                                <div class="mb-3 col-6">
                                                    <label class="form-label">Quantity:</label>
                                                    <input required name="quantity" value="<%= oldData.quantity%>"
                                                        type="text" class="form-control"
                                                        placeholder="Enter product quantity...">
                                                </div>
                                                <div class="mb-3  col-6">
                                                    <label class="form-label">Sold:</label>
                                                    <input required name="sold" value="<%= oldData.sold%>" type="text"
                                                        class="form-control" placeholder="(đơn vị: VNĐ)">
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Image URL:</label>
                                                <input name="image" value="<%= oldData.image%>" type="text"
                                                    class="form-control" placeholder="https://images.unsplash.com/...">
                                            </div>
                                            <div class="row">
                                                <div class="mb-3 col-6">
                                                    <label class="form-label">Factory</label>
                                                    <select name="factory" class="form-select">
                                                        <option value="APPLE" <%=oldData.factory==='APPLE' ? 'selected'
                                                            : '' %>>Apple (MacBook)</option>
                                                        <option value="ASUS" <%=oldData.factory==='ASUS' ? 'selected'
                                                            : '' %>>Asus</option>
                                                        <option value="LENOVO" <%=oldData.factory==='LENOVO'
                                                            ? 'selected' : '' %>>Lenovo</option>
                                                        <option value="DELL" <%=oldData.factory==='DELL' ? 'selected'
                                                            : '' %>>Dell</option>
                                                        <option value="LG" <%=oldData.factory==='LG' ? 'selected' : ''
                                                            %>>LG</option>
                                                        <option value="ACER" <%=oldData.factory==='ACER' ? 'selected'
                                                            : '' %>>Acer</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3 col-6">
                                                    <label class="form-label">Target</label>
                                                    <select name="target" class="form-select">
                                                        <option value="GAMING" <%=oldData.target==='GAMING' ? 'selected'
                                                            : '' %>>Gaming</option>
                                                        <option value="SINHVIEN-VANPHONG"
                                                            <%=oldData.target==='SINHVIEN-VANPHONG' ? 'selected' : '' %>
                                                            >Sinh viên - Văn phòng</option>
                                                        <option value="THIET-KE-DO-HOA"
                                                            <%=oldData.target==='THIET-KE-DO-HOA' ? 'selected' : '' %>
                                                            >Thiết kế đồ họa</option>
                                                        <option value="MONG-NHE" <%=oldData.target==='MONG-NHE'
                                                            ? 'selected' : '' %>>Mỏng nhẹ</option>
                                                        <option value="DOANH-NHAN" <%=oldData.target==='DOANH-NHAN'
                                                            ? 'selected' : '' %>>Doanh nhân</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <button type="submit" class="btn btn-warning"
                                                    class="form-control">Submit</button>
                                            </div>
                                        </form>
                                    </div>
                        </div>
                    </main>
                    <%- include('../layout/footer'); -%>
                </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
        <script src="/admin/js/scripts.js"></script>
</body>

</html>